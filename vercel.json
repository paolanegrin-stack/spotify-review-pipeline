{
  "version": 2,
  "builds": [
    {"src": "api/index.py", "use": "@vercel/python"},
    {"src": "web/**", "use": "@vercel/static"}
  ],
  "routes": [
    {"src": "/api/issues/([^/]+)/?", "dest": "/api/index.py?endpoint=issues&issue_id=$1"},
    {"src": "/api/(overview|ranking|memo|claims)/?", "dest": "/api/index.py?endpoint=$1"},
    {"src": "/", "dest": "/web/index.html"}
  ]
}
